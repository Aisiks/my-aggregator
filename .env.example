# Скопируй этот файл в .env и впиши свои значения. Файл .env НИКОГДА не коммить.

# Ключ OpenRouter (https://openrouter.ai/keys). Без него сайт работает в демо-режиме.
OPENROUTER_API_KEY=

# Адрес сайта (для статистики OpenRouter)
SITE_URL=https://prismai.kz

# Код доступа к моделям Pro для тестировщиков (пока нет аккаунтов и оплаты). Можно оставить пустым.
PRO_ACCESS_CODE=
